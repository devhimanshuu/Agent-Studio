datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum SkillStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  PAUSED_FOR_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
  STEP_LIMIT_EXCEEDED
}

enum StepStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
  AWAITING_APPROVAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ToolType {
  READ
  WRITE
}

enum McpTransport {
  SSE
  STDIO
}

enum McpServerStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  skills        Skill[]
  executions    Execution[]
  approvals     ApprovalRequest[]
  auditLogs     AuditLog[]
  mcpServers    McpServer[]

  @@map("users")
}

model Skill {
  id                 String         @id @default(cuid())
  userId             String
  name               String
  purpose            String
  status             SkillStatus    @default(DRAFT)
  currentDraftId     String?        @unique
  publishedVersionId String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions           SkillVersion[] @relation("SkillToVersions")

  @@index([userId])
  @@map("skills")
}

model SkillVersion {
  id                       String         @id @default(cuid())
  skillId                  String
  versionNumber            Int
  status                   SkillStatus    @default(DRAFT)
  inputSchema              Json           // JSON Schema definition
  outputSchema             Json           // JSON Schema definition
  instructions             String
  examples                 Json           // Array of input/output examples
  allowedTools             Json           // String array of permitted tool names
  actionsRequiringApproval Json           // String array of tool actions requiring human approval
  maxExecutionSteps        Int            @default(10)
  graphDefinition          Json?          // Visual multi-agent graph (nodes + edges) — drives the graph interpreter when present
  changelog                String?
  notes                    String?
  createdAt                DateTime       @default(now())
  publishedAt              DateTime?

  skill                    Skill          @relation("SkillToVersions", fields: [skillId], references: [id], onDelete: Cascade)
  executions               Execution[]

  @@unique([skillId, versionNumber])
  @@index([skillId, status])
  @@map("skill_versions")
}

model Execution {
  id                     String          @id @default(cuid())
  userId                 String
  skillVersionId         String
  skillName              String?         // Denormalized for history/search/metrics
  status                 ExecutionStatus @default(PENDING)
  inputData              Json
  finalOutput            Json?
  plannerOutput          Json?           // Plan produced by the planner node
  provider               String?         // LLM provider/model that served the planner
  durationMs             Int?            // Total wall-clock time of the run
  stepCount              Int             @default(0)
  maxSteps               Int
  errorMessage           String?
  startedAt              DateTime        @default(now())
  completedAt            DateTime?
  replayedFromExecutionId String?        // Set when this run was created by a replay

  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillVersion           SkillVersion    @relation(fields: [skillVersionId], references: [id])
  replayedFrom           Execution?      @relation("ExecutionReplay", fields: [replayedFromExecutionId], references: [id], onDelete: SetNull)
  replays                Execution[]     @relation("ExecutionReplay")
  steps                  ExecutionStep[]
  toolCalls              ToolCall[]
  logs                   ExecutionLog[]
  approvalRequests       ApprovalRequest[]
  auditLogs              AuditLog[]

  @@index([userId])
  @@index([skillVersionId])
  @@index([status])
  @@index([startedAt])
  @@index([replayedFromExecutionId])
  @@map("executions")
}

model ExecutionLog {
  id          String   @id @default(cuid())
  executionId String
  event       String   // e.g. EXECUTION_STARTED, PLANNER_FINISHED, TOOL_SELECTED, APPROVAL_REQUESTED
  level       String   // INFO | WARN | ERROR
  status      String?  // e.g. SUCCESS | FAILED | AWAITING_APPROVAL
  durationMs  Int?
  metadata    Json
  timestamp   DateTime @default(now())

  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([timestamp])
  @@map("execution_logs")
}

model ExecutionStep {
  id           String      @id @default(cuid())
  executionId  String
  stepNumber   Int
  nodeName     String
  stateSnapshot Json
  status       StepStatus  @default(RUNNING)
  startedAt    DateTime    @default(now())
  completedAt  DateTime?

  execution    Execution   @relation(fields: [executionId], references: [id], onDelete: Cascade)
  toolCalls    ToolCall[]

  @@unique([executionId, stepNumber])
  @@map("execution_steps")
}

model ToolCall {
  id             String      @id @default(cuid())
  executionId    String
  stepId         String?
  toolName       String
  action         String
  inputArgs      Json
  outputResult   Json?
  status         String      // SUCCESS | ERROR | BLOCKED | REJECTED
  errorMessage   String?
  durationMs     Int?        // Wall-clock execution time of the tool call
  executedAt     DateTime    @default(now())

  execution      Execution   @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step           ExecutionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@map("tool_calls")
}

model ApprovalRequest {
  id             String         @id @default(cuid())
  executionId    String
  userId         String
  skillName      String?        // Denormalized from the Skill for the review card
  plannerReason  String?        // Denormalized from the planner's reasoning
  toolName       String
  action         String
  inputPayload   Json
  status         ApprovalStatus @default(PENDING)
  idempotencyKey String         @unique // Single-use execution token
  requestedAt    DateTime       @default(now())
  respondedAt    DateTime?
  rejectionReason String?

  execution      Execution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([status])
  @@map("approval_requests")
}

model ApprovalHistory {
  id             String         @id @default(cuid())
  approvalId     String         // FK to ApprovalRequest
  executionId    String
  userId         String
  action         String         // CREATED | APPROVED | REJECTED | CANCELLED | EXPIRED | RESUMED
  details        Json
  timestamp      DateTime       @default(now())

  @@index([approvalId])
  @@index([executionId])
  @@map("approval_history")
}

model ToolDefinition {
  id                String   @id @default(cuid())
  name              String   @unique
  displayName       String
  description       String
  category          String?  // COMPUTE | SEARCH | DATA | TASK
  type              ToolType @default(READ)
  parameters        Json     // JSON Schema for tool parameters
  requiresAuth      Boolean  @default(false)
  requiresApproval  Boolean  @default(false) // WRITE actions that need HITL
  isSystem          Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@map("tool_definitions")
}

model VersionComparison {
  id         String   @id @default(cuid())
  userId     String
  skillId    String
  versionAId String
  versionBId String
  result     Json     // Serialized VersionDiffDTO
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([skillId])
  @@map("version_comparisons")
}

model McpServer {
  id           String          @id @default(cuid())
  userId       String
  name         String
  transport    McpTransport
  endpointUrl  String?
  command      String?
  headers      Json?
  status       McpServerStatus @default(DISCONNECTED)
  cachedTools  Json            @default("[]")
  lastError    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mcp_servers")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  executionId String?
  action      String   // e.g. SKILL_CREATED, VERSION_PUBLISHED, APPROVAL_GRANTED
  details     Json
  ipAddress   String?
  timestamp   DateTime @default(now())

  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  execution   Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([executionId])
  @@index([timestamp])
  @@map("audit_logs")
}
