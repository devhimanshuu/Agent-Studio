# =============================================================================
# Agent Studio — Environment Variables (names only — no real values!)
#
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit real keys. See README.md for full setup instructions.
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=

# --- Authentication (Clerk) --------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- LLM Providers (at least one is required for AI execution) ----------------
# Groq — https://console.groq.com
GROQ_API_KEY=
# OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY=
# OpenAI (optional / future provider)
OPENAI_API_KEY=

# --- MCP (Model Context Protocol) ---------------------------------------------
# Optional bearer token for external MCP clients (Cursor / Claude Desktop)
# connecting to /api/mcp/sse. Leave empty to allow only Clerk sessions.
MCP_ACCESS_TOKEN=

# --- App ----------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional — log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
