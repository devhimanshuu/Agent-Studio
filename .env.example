# =============================================================================
# Agent Studio — Environment Variables
#
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit real keys. See README.md for full setup instructions.
#
# Quick start with docker compose:
#   docker compose up -d
#   cp .env.example .env.local
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# Default from docker-compose.yml: postgres:16-alpine
DATABASE_URL=postgresql://agent:secret@localhost:5432/agentstudio

# --- Authentication (Clerk) --------------------------------------------------
# Get keys at https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- LLM Providers (at least one is required for AI execution) ----------------
# Groq — https://console.groq.com (free tier: 14K RPM, llama-3.3-70b)
# Also used for embeddings via the OpenAI-compatible /v1/embeddings endpoint.
GROQ_API_KEY=
# OpenRouter — https://openrouter.ai (free tier: some models)
# Primary fallback for embeddings when Groq is unavailable.
OPENROUTER_API_KEY=
# OpenAI (NO LONGER USED — embeddings were removed permanently; only kept
# here for backwards-compatibility with older Groq/OpenRouter env files).
# Setting OPENAI_API_KEY does NOT enable OpenAI embeddings.
OPENAI_API_KEY=

# --- MCP (Model Context Protocol) ---------------------------------------------
# Optional bearer token for external MCP clients (Cursor / Claude Desktop)
# connecting to /api/mcp/sse. Leave empty to allow only Clerk sessions.
MCP_ACCESS_TOKEN=

# --- App ----------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Vault (Secret Encryption) ------------------------------------------------
# Required for production. Generate with: npx tsx scripts/vault-rotate-keys.ts --generate-key
# Must be a 64-character hex string (32 bytes).
VAULT_MASTER_KEY=
# Comma-separated list of active key versions (default: "1")
# Update after key rotation to include new versions.
VAULT_KEY_VERSIONS=1

# --- Open-Source Microservice Nodes --------------------------------------------
# All services are configurable per-graph-node via the canvas UI.
# These env vars provide DEFAULT fallback URLs for convenience.
# Spin up only what your workflows use: docker compose up -d <service>

# SearXNG (metasearch engine) — docker: searxng/searxng
# Start: docker compose up -d searxng
# Docs: https://docs.searxng.org
SEARXNG_HOST=http://localhost:8080

# Crawl4AI (web scraper) — docker: unclecode/crawl4ai
# Start: docker compose up -d crawl4ai
# Docs: https://github.com/unclecode/crawl4ai
CRAWL4AI_HOST=http://localhost:11235

# Docling (IBM document parser) — docker: ghcr.io/docling-project/docling-serve
# Start: docker compose up -d docling
# Docs: https://github.com/docling-project/docling
DOCLING_HOST=http://localhost:5001

# Gotenberg (PDF engine) — docker: gotenberg/gotenberg:8
# Start: docker compose up -d gotenberg
# Docs: https://gotenberg.dev
GOTENBERG_HOST=http://localhost:3000

# NocoDB (open-source Airtable) — docker: nocodb/nocodb
# Start: docker compose up -d nocodb
# Docs: https://nocodb.com
# After first start, create an API token: NocoDB UI -> Team & Settings -> API Tokens
NOCODB_HOST=http://localhost:8085
NOCODB_API_TOKEN=

# PocketBase (lightweight backend / KV store) — docker: ghcr.io/muchobien/pocketbase
# Start: docker compose up -d pocketbase
# Docs: https://pocketbase.io
POCKETBASE_HOST=http://localhost:8090

# Qdrant (vector database for RAG) — docker: qdrant/qdrant
# Start: docker compose up -d qdrant
# Docs: https://qdrant.tech
QDRANT_HOST=http://localhost:6333
# Optional — only if you set QDRANT__SERVICE__API_KEY on the server
QDRANT_API_KEY=

# Faster-Whisper (speech-to-text) — docker: fedirz/faster-whisper-server
# Start: docker compose up -d whisper
# Uses ~5GB VRAM for large-v3-turbo model. Use :latest-cpu image for CPU-only.
# Docs: https://github.com/fedirz/faster-whisper-server
WHISPER_HOST=http://localhost:8000

# Piper TTS (text-to-speech) — docker: rhasspy/wyoming-piper
# Start: docker compose up -d piper
# Docs: https://github.com/rhasspy/piper
PIPER_TTS_HOST=http://localhost:5000

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info

# --- A2A Agent Registry (optional) --------------------------------------------
# If set, /api/a2a/discover and /api/a2a/auction pull manifests from this
# upstream registry before falling back to the built-in presets. The endpoint
# must return JSON of shape: { "agents": [AgentManifest, ...] }.
A2A_REGISTRY_URL=
A2A_REGISTRY_TOKEN=
